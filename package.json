{
  "name": "titan-bank",
  "version": "1.0.0",
  "description": "Titan Bank Offline Android App",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:add": "cap add android",
    "cap:sync": "cap sync android",
    "build:apk": "npm run build && npx cap sync android && cd android && .\\gradlew assembleDebug && cd .. && powershell -Command \"Copy-Item android/app/build/outputs/apk/debug/app-debug.apk TitanBank.apk -Force\""
  },
